  const sh = book().getSheetByName(SH_L); if (!sh) return { ok: true, gu: {} };
  const n = sh.getLastRow(); if (n < 2) return { ok: true, gu: {} };
  const from = Math.max(2, n - 30000 + 1);
  const vals = sh.getRange(from, 1, n - from + 1, 6).getValues();
