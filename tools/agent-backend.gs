  const bill = dpBillOn();
  if (new Date(dpDayMs(t) + 9 * 3600000).getUTCDate() === 1 || P.getProperty('DP_CHK_M') === t.slice(0, 7) + '|go') { try { n += dpMonthlyCheck(t); } catch (e) {} }   // 매달 1일: 등록 상태 다시 확인(나눠서)
  dpAll().forEach(p => {
