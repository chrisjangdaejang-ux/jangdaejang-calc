const PTH = ['id', '신청일', '유형', '상호', '사업자번호', '중개등록번호', '담당자', '연락처', '이메일', '활동지역', '채널', '소개', '관리코드해시',
             '승인', '계약서일', '정산방법', '동의', '상태', '메모'];
