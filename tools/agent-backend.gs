    src: LEAD_SRC[r[AGQC['출처']]] || '', kind: LEAD_KIND[r[AGQC['종류']]] || '', g: String(r[AGQC['구코드']]), k: String(r[AGQC['단지키']]).replace(/^'/, ''),
    apt: String(r[AGQC['단지명']]).replace(/^'/, ''), band: String(r[AGQC['평형']]).replace(/^'/, ''), mode: String(r[AGQC['방식']]), others: others,
