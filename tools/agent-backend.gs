/* ---------- 매일 할 일(briefDaily 끝에서) ---------- */
function dpDaily(now) {
  if (!DONGNE_ENABLED || !book().getSheetByName(SH_DP)) return 0;
  const P = PropertiesService.getScriptProperties(), t = ymd(now || new Date());
