      dpMailTo(p.mail, `[${SITE_NAME}] 4주 동안 동네 한마디가 없었어요`, `글이 없으면 이름 카드만 뒤쪽에 보여요. 짧은 동네 소식 하나면 충분해요.<br><a href="${WEB_ROOT}dongne/my/#write">글 쓰러 가기</a>`); add('idle|' + since); n++;
    }
  });
  /* 끊긴 지 30일 지난 창립 혜택은 영영 사라짐(다시 가입해도 없음) */
