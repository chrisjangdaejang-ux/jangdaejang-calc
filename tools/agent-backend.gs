  r[CSAC['id']] = id; r[CSAC['시각']] = new Date(); r[CSAC['질문id']] = String(o.r[CSQC['id']]); r[CSAC['종류']] = team ? 'team' : 'pro';
  r[CSAC['전문가id']] = pro ? String(pro.r[CSPC['id']]) : ''; r[CSAC['회원']] = me; r[CSAC['내용']] = cellSafe(t.text.trim());
