const AQ_PERIOD = ['', '1주', '2주', '1개월', '8주(2개월)', '3개월', '6개월', '1년', '미정·협의'];   // v38: 8주(2개월) — 광고 설계 도우미 8주 구성
const AQ_DAILY = 40;          // 하루 전체 문의 상한(스팸 방지)

function aqSheet() {
