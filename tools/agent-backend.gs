AQ_PROD.list_card = '목록 사이 카드'; AQ_PROD.end_card = '페이지 끝 카드';   // v39: ad/ 문의 폼 광고 칸 카드 두 자리(재배포 전 서버는 함께 보내는 'etc'로 접수)
