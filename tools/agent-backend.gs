  try { csUserGone(u.k); } catch (e) {}   // v56 고민 상담: 질문·답변 내용·연락처 지우기, 전문가 신청 중지
  try { mvUserGone(u.k); } catch (e) {}   // v57 이사 견적: 보낸 요청 연락처 지우기 · 업체 해지
  del('플러스중개사', 0); del('내손님', 1);   // v27 중개사 플러스: 표시 정보·손님 이름표·단지(시트 이름은 아래 SH_BPP·SH_BPC 와 같음)
  let unlinked = false;
