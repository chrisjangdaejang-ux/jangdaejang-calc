    pro = csProById(b.to);
    if (!pro || String(pro.r[CSPC['상태']]) !== CS_PRO_ST.ok) throw csErr('전문가를 다시 골라 주세요.', 'field');
    const only = CS_CAT_ONLY[cat]; if (only && only.indexOf(String(pro.r[CSPC['종류']])) < 0) throw csErr(csKindMsg(cat) + ' 다른 전문가를 골라 주세요.', 'field');
