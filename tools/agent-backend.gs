    if (!c.ok) throw csErr({ unverified: '자격 확인이 끝난 전문가만 답할 수 있어요.', private: '지정된 전문가만 답할 수 있는 비공개 상담이에요.', kind: csKindMsg(String(o.r[CSQC['분류']])),
