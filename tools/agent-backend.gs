  const cb = csCheckText('body', b.body); if (!cb.ok) throw csErr(cb.err, 'field');
  const nick = csNick(b.nick);
  const use = String(b.use || ''); if (use && use !== 'pick' && use !== 'private') throw csErr('질문 방법을 다시 골라 주세요.', 'field');
  let pro = null;
