    prog[me.id] = { s: step, at: Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyy-MM-dd HH:mm') };
    sh.getRange(i + 1, AGQC['진행'] + 1).setValue(JSON.stringify(prog));
    v[i][AGQC['진행']] = JSON.stringify(prog);
