    .map(h => [String(h[0]), String(h[1]), Math.round(Number(h[2])) || 0, Math.round(Number(h[3])) || 0]).filter(h => h[2] > 0 && h[2] < 10000000 && h[3] >= 0 && h[3] < 10000000).slice(-120);
